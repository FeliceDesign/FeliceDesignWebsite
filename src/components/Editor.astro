---
// Temporary tuning overlay. The panel markup is always in the page but hidden;
// src/scripts/editor.ts only builds the sliders (and shows it) when ?editor is
// present, so normal visitors never see it and it costs them nothing but an
// empty hidden <aside>. The editor writes CSS variables live and can export the
// current values as a presets.ts patch.
---

<aside id="editor" hidden aria-label="Design-Editor">
  <header>
    <strong>Editor</strong>
    <button id="editor-close" title="Schließen">✕</button>
  </header>
  <div id="editor-fields"></div>
  <footer>
    <button id="editor-reset">Zurücksetzen</button>
    <button id="editor-export">Export</button>
  </footer>
  <textarea id="editor-out" readonly hidden></textarea>
</aside>

<style is:global>
  #editor {
    position: fixed;
    top: 0;
    right: 0;
    z-index: 200;
    width: 320px;
    max-height: 100vh;
    overflow-y: auto;
    background: rgba(18, 20, 24, 0.94);
    backdrop-filter: blur(12px);
    border-left: 1px solid rgba(255, 255, 255, 0.08);
    color: #f2f0ec;
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 12px;
    padding: 14px 16px 20px;
    cursor: default;
  }
  #editor[hidden] { display: none; }
  #editor header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }
  #editor header strong { letter-spacing: 0.12em; text-transform: uppercase; }
  #editor button {
    background: rgba(255, 255, 255, 0.08);
    color: inherit;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 6px;
    padding: 5px 10px;
    cursor: pointer;
    font: inherit;
  }
  #editor button:hover { background: rgba(255, 255, 255, 0.16); }
  #editor .group-title {
    margin: 14px 0 6px;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #8fb4cc;
  }
  #editor .field { margin-bottom: 9px; }
  #editor .field label {
    display: flex;
    justify-content: space-between;
    margin-bottom: 3px;
    color: #b8c0c8;
  }
  #editor .field label .val { color: #e0a56a; font-variant-numeric: tabular-nums; }
  #editor input[type='range'] { width: 100%; accent-color: #e0a56a; }
  #editor footer { display: flex; gap: 8px; margin-top: 16px; }
  #editor footer button { flex: 1; }
  #editor textarea {
    width: 100%;
    height: 180px;
    margin-top: 10px;
    background: #0c0d0f;
    color: #b8c0c8;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 6px;
    padding: 8px;
    font-family: ui-monospace, monospace;
    font-size: 11px;
    resize: vertical;
  }
</style>
